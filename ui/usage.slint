// The usage panel, over the conversation: the plan and its limits and when they start over,
// this session's cost and time, what fills the context, and the last day and week as the CLI's
// `/usage` sees them, with its advice; a tab for each. Esc or the cross closes it.

import { Theme } from "theme.slint";
import { Usage } from "state.slint";
import { Caption, Icon, IconButton, Meter, Pressable, Small, Title } from "widgets.slint";

component StatLine inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <float> fraction;
    spacing: 2px;
    HorizontalLayout {
        spacing: Theme.space-m;
        Text {
            text: root.label;
            color: Theme.text;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }
        Text {
            text: root.value;
            color: Theme.fill-text(root.fraction);
            font-family: Theme.mono;
            font-size: 1rem * Theme.code-size;
        }
    }
    if root.fraction >= 0: Meter {
        fraction: root.fraction;
    }
    if root.detail != "": Small {
        text: root.detail;
        wrap: word-wrap;
    }
}

export component UsagePanel inherits Rectangle {
    // The section shown: the one picked, or the last there is.
    property <int> tab: 0;
    property <int> shown: max(0, min(root.tab, Usage.sections.length - 1));
    background: Theme.surface;
    VerticalLayout {
        HorizontalLayout {
            height: Theme.header;
            padding-left: Theme.space-xl;
            padding-right: Theme.space-m;
            spacing: Theme.space-m;
            Icon {
                source: @image-url("@lucide/gauge.svg");
                tint: Theme.claude;
                width: 22px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Title {
                    text: "Usage";
                }
                Caption {
                    text: Usage.loading ? "Asking Claude Code" : "As Claude Code's /usage and /context report it";
                }
            }
            IconButton {
                icon: @image-url("@lucide/refresh-cw.svg");
                label: "Ask again";
                enabled: !Usage.loading;
                y: (parent.height - self.height) / 2;
                clicked => { Usage.refresh(); }
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: "Back to the conversation (Esc)";
                y: (parent.height - self.height) / 2;
                clicked => { Usage.close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        if Usage.note != "": HorizontalLayout {
            padding: Theme.space-m;
            padding-left: Theme.space-xl;
            Small {
                text: Usage.note;
                color: Theme.warning-text;
                wrap: word-wrap;
            }
        }
        // A tab for each section, one shown at a time, instead of one long list.
        HorizontalLayout {
            // The section below takes the height, however little it shows.
            vertical-stretch: 0;
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            padding-top: Theme.space-m;
            spacing: Theme.space-xs;
            alignment: start;
            for section[index] in Usage.sections: Pressable {
                selected: index == root.shown;
                accessible-label: section.title;
                clicked => { root.tab = index; }
                HorizontalLayout {
                    padding-left: Theme.space-m;
                    padding-right: Theme.space-m;
                    padding-top: Theme.space-s;
                    padding-bottom: Theme.space-s;
                    Text {
                        text: section.title;
                        color: index == root.shown ? Theme.text : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if Usage.sections.length == 0: VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.space-xl;
            alignment: start;
            Small {
                text: Usage.loading ? "" : "Claude Code has no numbers to report yet.";
                wrap: word-wrap;
            }
        }
        if Usage.sections.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: shown-section.preferred-height;
            shown-section := HorizontalLayout {
                alignment: center;
                padding-top: Theme.space-l;
                padding-bottom: Theme.space-xl;
                VerticalLayout {
                    width: min(root.width - 2 * Theme.space-xl, 720px);
                    spacing: Theme.space-m;
                    if Usage.sections[root.shown].note != "": Small {
                        text: Usage.sections[root.shown].note;
                    }
                    for row in Usage.sections[root.shown].rows: StatLine {
                        label: row.label;
                        value: row.value;
                        detail: row.detail;
                        fraction: row.fraction;
                    }
                }
            }
        }
    }
}
