// The rows of the transcript: the user's messages, Claude's Markdown, tool calls with their
// input, output and diffs, and notes. Selectable text is keyed by entry and part: `e3:b0` for
// the first Markdown block of entry 3, `e3:b0:r1c2` for a cell of it, `e3:detail`, `e3:output`,
// `e3:text`.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BlockKind, DiffKind, DiffLine, Entry, EntryKind, GroupRole, ImageState, MdBlock, ShownImage, ToolState } from "types.slint";
import { Clipboard, Transcript } from "state.slint";
import { Caption, CodeBox, Icon, IconButton, Pressable, Selectable, Small, TableCell } from "widgets.slint";

// A table as wide as its cells need, up to the column. Narrower, its cells wrap, each column
// giving up width by its share of `column-stretch`, down to its longest word; past that the
// table scrolls sideways. Copying takes its Markdown.
component TableView inherits HorizontalLayout {
    in property <MdBlock> block;
    in property <string> key;
    // Fluent's horizontal scroll bar lies over the bottom of what it scrolls.
    property <length> scroll-bar: 14px;
    property <bool> overflowing: grid.min-width > scroll.visible-width;
    alignment: start;
    spacing: Theme.space-xs;
    Rectangle {
        // Not the grid's: the scroll view takes what the grid can't fit.
        min-width: 0px;
        preferred-width: grid.preferred-width;
        height: scroll.height;
        clip: true;
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: Theme.divider;
        scroll := ScrollView {
            width: parent.width;
            height: grid.preferred-height + (root.overflowing ? root.scroll-bar : 0px);
            vertical-scrollbar-policy: always-off;
            content-width: max(self.visible-width, grid.min-width);
            content-height: grid.preferred-height;
            grid := GridLayout {
                width: scroll.content-width;
                height: scroll.content-height;
                // Inside the border.
                padding: 1px;
                for row[row-index] in root.block.rows: Row {
                    for cell[column-index] in row.cells: Rectangle {
                        horizontal-stretch: root.block.column-stretch[column-index];
                        background: row-index == 0 ? Theme.code : Math.mod(row-index, 2) == 0 ? Theme.subtle : transparent;
                        HorizontalLayout {
                            padding-left: Theme.space-s;
                            padding-right: Theme.space-s;
                            padding-top: Theme.space-xs;
                            padding-bottom: Theme.space-xs;
                            TableCell {
                                text: cell;
                                key: "\{root.key}:r\{row-index}c\{column-index}";
                                default-font-family: root.block.font;
                                default-font-size: 1rem * Theme.message;
                                line-height-factor: Theme.tight-line-factor(root.block.font);
                            }
                        }
                    }
                }
            }
        }
    }
    VerticalLayout {
        alignment: start;
        IconButton {
            icon: @image-url("@lucide/copy.svg");
            label: "Copy table";
            width: 24px;
            height: 24px;
            icon-size: Theme.icon-small;
            tint: Theme.text-faint;
            clicked => { Clipboard.copy(root.block.raw); }
        }
    }
}

// One block of Markdown; `key` tells its selection apart (see `TextSelection`).
export component BlockView inherits VerticalLayout {
    in property <MdBlock> block;
    in property <string> key;
    in property <bool> first;
    // How far prose keeps in from each side, so that it holds to its measure while code and
    // tables may take the `room` there is (see `Theme.measure`). Both come from the row's
    // width, never from what the blocks hold. Without an inset, every block fills the width.
    in property <length> inset;
    in property <length> room;
    if root.block.kind == BlockKind.text: HorizontalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        Selectable {
            text: root.block.body;
            key: root.key;
            default-font-family: root.block.font;
            default-font-size: 1rem * Theme.message;
            line-height-factor: Theme.line-factor(root.block.font);
        }
    }
    // Bold already (see `src/ui/mod.rs`); a size by level.
    if root.block.kind == BlockKind.heading: VerticalLayout {
        padding-top: root.first ? 0 : Theme.space-xs;
        padding-left: root.inset;
        padding-right: root.inset;
        Selectable {
            text: root.block.body;
            key: root.key;
            default-font-family: root.block.font;
            line-height-factor: Theme.tight-line-factor(root.block.font);
            default-font-size: 1rem * Theme.message * (root.block.level == 1 ? Theme.heading : root.block.level == 2 ? Theme.title : 1.0);
        }
    }
    // Code and tables are never narrower than the prose, and wider as their content needs, up
    // to the room there is.
    if root.block.kind == BlockKind.code: HorizontalLayout {
        property <length> side: min(root.inset, max(0px, (root.room - code.preferred-width) / 2));
        padding-left: self.side;
        padding-right: self.side;
        code := CodeBox {
            body: root.block.body;
            key: root.key;
            label: root.block.lang;
            copyable: true;
            keeps-lines: true;
            scale: Theme.message;
            copy => { Clipboard.copy(root.block.raw); }
        }
    }
    if root.block.kind == BlockKind.table: HorizontalLayout {
        property <length> side: min(root.inset, max(0px, (root.room - table.preferred-width) / 2));
        padding-left: self.side;
        padding-right: self.side;
        table := TableView {
            block: root.block;
            key: root.key;
        }
    }
    if root.block.kind == BlockKind.quote: HorizontalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        spacing: Theme.space-m;
        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: Theme.divider;
        }
        Selectable {
            text: root.block.body;
            key: root.key;
            default-color: Theme.text-secondary;
            default-font-family: root.block.font;
            default-font-size: 1rem * Theme.message;
            line-height-factor: Theme.line-factor(root.block.font);
        }
    }
    if root.block.kind == BlockKind.rule: VerticalLayout {
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        padding-left: root.inset;
        padding-right: root.inset;
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
    }
}

export component MarkdownView inherits VerticalLayout {
    in property <[MdBlock]> blocks;
    in property <int> index;
    // See `BlockView`.
    in property <length> inset;
    in property <length> room;
    spacing: Theme.space-s;
    for block[i] in root.blocks: BlockView {
        block: block;
        key: "e\{root.index}:b\{i}";
        first: i == 0;
        inset: root.inset;
        room: root.room;
    }
}

component DiffView inherits Rectangle {
    in property <[DiffLine]> lines;
    background: Theme.code;
    border-radius: Theme.radius-m;
    clip: true;
    VerticalLayout {
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        for line in root.lines: Rectangle {
            background: line.kind == DiffKind.added ? Theme.added : line.kind == DiffKind.removed ? Theme.removed : transparent;
            HorizontalLayout {
                padding-left: Theme.space-s;
                padding-right: Theme.space-m;
                spacing: Theme.space-s;
                Text {
                    width: 10px;
                    text: line.kind == DiffKind.added ? "+" : line.kind == DiffKind.removed ? "−" : "";
                    color: line.kind == DiffKind.added ? Theme.added-text : Theme.removed-text;
                    font-family: Theme.mono;
                    font-size: 1rem * Theme.code-size;
                    line-height-factor: Theme.code-line-factor;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: line.text;
                    wrap: word-wrap;
                    color: line.kind == DiffKind.hunk ? Theme.text-faint : Theme.text;
                    font-family: Theme.mono;
                    font-size: 1rem * Theme.code-size;
                    line-height-factor: Theme.code-line-factor;
                }
            }
        }
    }
}

// Before a tool call's name: how far it got, by shape as well as colour (Gruvbox's green and
// yellow are close): a dot while it runs, a hand while it waits for the user, a check,
// a cross, a slashed circle.
// An image in the conversation: its pixels at the screen's scale, at most 480px wide and the
// room there is, its shape kept; a frame while it is decoded; why, if it isn't shown.
component ImageView inherits HorizontalLayout {
    in property <ShownImage> shown;
    in property <length> room;
    // Where it came from (a tool call's summary, the file read, say), naming it for assistive
    // technology; empty for one the user sent.
    in property <string> origin;
    property <length> shown-width: min(root.room, 480px, root.shown.width-px * 1phx);
    alignment: start;
    if root.shown.state == ImageState.shown: Rectangle {
        width: root.shown-width;
        height: root.shown-width * root.shown.height-px / max(1, root.shown.width-px);
        border-radius: Theme.radius-m;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.shown.image;
            accessible-role: image;
            accessible-label: (root.origin == "" ? "Image" : "Image from " + root.origin)
                + ", \{root.shown.width-px} × \{root.shown.height-px} pixels";
        }
    }
    if root.shown.state == ImageState.pending: Rectangle {
        width: min(root.room, 160px);
        height: 90px;
        border-radius: Theme.radius-m;
        background: Theme.surface;
        Caption {
            text: "Image";
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    if root.shown.state == ImageState.failed: Small {
        text: "Image not shown: \{root.shown.note}";
        color: Theme.text-tertiary;
        wrap: word-wrap;
        max-width: root.room;
    }
}

component StateMark inherits Rectangle {
    in property <ToolState> state;
    property <bool> working: root.state == ToolState.running || root.state == ToolState.streaming;
    width: Theme.icon-small;
    height: Theme.icon-small;
    if root.working: Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.claude;
    }
    if !root.working: Icon {
        width: parent.width;
        source: root.state == ToolState.done ? @image-url("@lucide/check.svg")
            : root.state == ToolState.failed ? @image-url("@lucide/x.svg")
            : root.state == ToolState.awaiting ? @image-url("@lucide/hand.svg")
            : root.state == ToolState.denied ? @image-url("@lucide/ban.svg")
            : @image-url("@lucide/circle-slash.svg");
        tint: root.state == ToolState.done ? Theme.success
            : root.state == ToolState.failed ? Theme.danger-text
            : root.state == ToolState.awaiting ? Theme.warning
            : Theme.text-faint;
    }
}

// A run of tool calls in one line: open or folded, how it went, what it did.
component RunLine inherits Pressable {
    in property <Entry> entry;
    in property <int> index;
    height: Theme.row;
    accessible-label: root.entry.group-summary;
    clicked => { Transcript.toggle-group(root.index); }
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        Icon {
            source: root.entry.group-open ? @image-url("@lucide/chevron-down.svg") : @image-url("@lucide/chevron-right.svg");
            width: Theme.icon-small;
            tint: Theme.text-faint;
            y: (parent.height - self.height) / 2;
        }
        StateMark {
            state: root.entry.group-state;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.entry.group-summary;
            color: root.entry.group-state == ToolState.failed ? Theme.danger-text : Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
        }
    }
}

component ToolCard inherits Rectangle {
    in property <Entry> entry;
    in property <int> index;
    // How wide its images may be: from the row, as the card sizes itself from what it holds.
    in property <length> image-room;
    // As wide as its diff, input, output and images need, for the row to give it that much
    // where there is room; its summary line and Markdown wrap or shorten to fit instead.
    out property <length> natural-width: content.preferred-width;
    property <string> state-label: root.entry.tool-state == ToolState.awaiting ? "Waiting for you"
        : root.entry.tool-state == ToolState.failed ? "Failed"
        : root.entry.tool-state == ToolState.denied ? "Denied"
        : root.entry.tool-state == ToolState.cancelled ? "Cancelled"
        : "";
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: root.entry.tool-state == ToolState.awaiting ? Theme.warning : Theme.divider;
    background: Theme.card;
    content := VerticalLayout {
        Pressable {
            border-radius: Theme.radius-m;
            clicked => { Transcript.toggle(root.index); }
            HorizontalLayout {
                padding: Theme.space-s;
                padding-left: Theme.space-m;
                spacing: Theme.space-s;
                StateMark {
                    state: root.entry.tool-state;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.entry.tool-title;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    text: root.entry.tool-summary;
                    color: Theme.text-secondary;
                    font-family: root.entry.tool-summary-prose ? Theme.sans : Theme.mono;
                    font-size: root.entry.tool-summary-prose ? 1rem : 1rem * Theme.code-size;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    preferred-width: 0px;
                }
                if root.state-label != "": Small {
                    text: root.state-label;
                    vertical-alignment: center;
                    color: root.entry.tool-state == ToolState.failed ? Theme.danger-text : Theme.text-tertiary;
                }
                Icon {
                    source: root.entry.expanded ? @image-url("@lucide/chevron-down.svg") : @image-url("@lucide/chevron-right.svg");
                    width: Theme.icon-small;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        if root.entry.expanded: VerticalLayout {
            padding: Theme.space-s;
            padding-top: 0;
            spacing: Theme.space-s;
            if root.entry.diff.length > 0: DiffView {
                lines: root.entry.diff;
            }
            if root.entry.has-detail: CodeBox {
                body: root.entry.detail;
                key: "e\{root.index}:detail";
                ink: Theme.text-secondary;
            }
            if root.entry.blocks.length > 0: Rectangle {
                preferred-width: 0px;
                border-radius: Theme.radius-m;
                background: Theme.surface;
                VerticalLayout {
                    padding: Theme.space-m;
                    MarkdownView {
                        blocks: root.entry.blocks;
                        index: root.index;
                    }
                }
            }
            if root.entry.has-output: CodeBox {
                body: root.entry.output;
                key: "e\{root.index}:output";
                ink: root.entry.tool-state == ToolState.failed ? Theme.danger-text : Theme.text;
                note: root.entry.output-note;
                copyable: true;
                copy => { Transcript.copy-entry(root.index); }
            }
            for shown in root.entry.images: ImageView {
                shown: shown;
                room: root.image-room;
                origin: root.entry.tool-summary;
            }
        }
    }
}

component UserBubble inherits HorizontalLayout {
    in property <Entry> entry;
    in property <int> index;
    alignment: end;
    Rectangle {
        max-width: root.width * 0.85;
        border-radius: Theme.bubble-radius;
        background: Theme.bubble;
        HorizontalLayout {
            padding-left: Theme.space-l;
            padding-right: Theme.space-l;
            padding-top: 10px;
            padding-bottom: 10px;
            Selectable {
                text: root.entry.body;
                key: "e\{root.index}:text";
                default-font-family: root.entry.font;
                default-font-size: 1rem * Theme.message;
                line-height-factor: Theme.line-factor(root.entry.font);
            }
        }
    }
}

// A message another session sent this one: on Claude's side, as Claude is the one it is for,
// with who sent it above it, so it isn't taken for something the user wrote.
component PeerBubble inherits HorizontalLayout {
    in property <Entry> entry;
    in property <int> index;
    alignment: start;
    Rectangle {
        max-width: root.width * 0.85;
        border-radius: Theme.bubble-radius;
        border-width: 1px;
        border-color: Theme.control-border;
        VerticalLayout {
            padding-left: Theme.space-l;
            padding-right: Theme.space-l;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: Theme.space-xs;
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-s;
                Icon {
                    source: @image-url("@lucide/messages-square.svg");
                    tint: Theme.text-tertiary;
                    width: Theme.icon-small;
                }
                Text {
                    text: "Message from \{root.entry.sender}";
                    color: Theme.text-tertiary;
                    font-size: 1rem * Theme.small;
                    vertical-alignment: center;
                }
            }
            Selectable {
                text: root.entry.body;
                key: "e\{root.index}:text";
                default-font-family: root.entry.font;
                default-font-size: 1rem * Theme.message;
                line-height-factor: Theme.line-factor(root.entry.font);
            }
        }
    }
}

component AssistantText inherits VerticalLayout {
    in property <Entry> entry;
    in property <int> index;
    // See `BlockView`.
    in property <length> inset;
    in property <length> room;
    spacing: 2px;
    MarkdownView {
        blocks: root.entry.blocks;
        index: root.index;
        inset: root.inset;
        room: root.room;
    }
    HorizontalLayout {
        alignment: start;
        padding-left: root.inset;
        IconButton {
            icon: @image-url("@lucide/copy.svg");
            label: "Copy message";
            width: 24px;
            height: 24px;
            icon-size: Theme.icon-small;
            tint: Theme.text-faint;
            clicked => { Transcript.copy-entry(root.index); }
        }
    }
}

component Thinking inherits VerticalLayout {
    in property <Entry> entry;
    in property <int> index;
    spacing: Theme.space-xs;
    HorizontalLayout {
        alignment: start;
        Pressable {
            clicked => { Transcript.toggle(root.index); }
            HorizontalLayout {
                padding: Theme.space-xs;
                padding-right: Theme.space-s;
                spacing: Theme.space-xs;
                Icon {
                    source: @image-url("@lucide/brain.svg");
                    width: Theme.icon-small;
                    tint: Theme.text-tertiary;
                    y: (parent.height - self.height) / 2;
                }
                Small {
                    text: "Thinking";
                    vertical-alignment: center;
                }
                Icon {
                    source: root.entry.expanded ? @image-url("@lucide/chevron-down.svg") : @image-url("@lucide/chevron-right.svg");
                    width: Theme.icon-small;
                    tint: Theme.text-tertiary;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
    if root.entry.expanded: HorizontalLayout {
        padding-left: Theme.space-s;
        spacing: Theme.space-m;
        Rectangle {
            width: 2px;
            background: Theme.divider;
        }
        Selectable {
            text: root.entry.body;
            key: "e\{root.index}:text";
            default-color: Theme.text-tertiary;
            default-font-family: root.entry.font;
            default-font-size: 1rem * Theme.message;
            line-height-factor: Theme.line-factor(root.entry.font);
        }
    }
}

export component EntryView inherits VerticalLayout {
    in property <Entry> entry;
    in property <int> index;
    padding-left: root.entry.nested ? Theme.space-xl : 0;
    // The room the row gives (its width is the caller's, never what the entry holds), and the
    // prose's measure in it, centered on the same line (see `Theme.measure`).
    property <length> room: root.width - root.padding-left;
    property <length> prose: min(self.room, Theme.measure);
    if root.entry.kind == EntryKind.user: UserBubble {
        width: root.prose;
        cross-axis-self-alignment: center;
        entry: root.entry;
        index: root.index;
    }
    // An image the user sent, where their messages are.
    if root.entry.kind == EntryKind.image: HorizontalLayout {
        width: root.prose;
        cross-axis-self-alignment: center;
        alignment: end;
        for shown in root.entry.images: ImageView {
            shown: shown;
            room: root.prose * 0.85;
        }
    }
    if root.entry.kind == EntryKind.peer: PeerBubble {
        width: root.prose;
        cross-axis-self-alignment: center;
        entry: root.entry;
        index: root.index;
    }
    if root.entry.kind == EntryKind.assistant: AssistantText {
        entry: root.entry;
        index: root.index;
        inset: (root.room - root.prose) / 2;
        room: root.room;
    }
    if root.entry.kind == EntryKind.thinking: Thinking {
        width: root.prose;
        cross-axis-self-alignment: center;
        entry: root.entry;
        index: root.index;
    }
    if root.entry.group == GroupRole.head: RunLine {
        width: root.prose;
        cross-axis-self-alignment: center;
        entry: root.entry;
        index: root.index;
    }
    // An open run's calls, indented under its line; a folded run shows only the line. A card
    // is as wide as the prose, or as its content needs where there is room.
    if root.entry.kind == EntryKind.tool && (root.entry.group == GroupRole.alone || root.entry.group-open): tool-row := HorizontalLayout {
        property <length> indent: root.entry.group == GroupRole.alone ? 0 : Theme.space-l;
        cross-axis-self-alignment: center;
        padding-left: self.indent;
        padding-top: root.entry.group == GroupRole.head ? Theme.space-xs : 0;
        ToolCard {
            width: max(root.prose - tool-row.indent, min(self.natural-width, root.room - tool-row.indent));
            entry: root.entry;
            index: root.index;
            image-room: root.room - tool-row.indent - 2 * Theme.space-s;
        }
    }
    if root.entry.kind == EntryKind.info: Selectable {
        width: root.prose;
        cross-axis-self-alignment: center;
        text: root.entry.body;
        key: "e\{root.index}:text";
        horizontal-alignment: center;
        default-color: Theme.text-tertiary;
        default-font-size: 1rem * Theme.small;
        default-font-family: root.entry.font;
        line-height-factor: Theme.line-factor(root.entry.font);
    }
    if root.entry.kind == EntryKind.error: Rectangle {
        width: root.prose;
        cross-axis-self-alignment: center;
        border-radius: Theme.radius-m;
        background: Theme.danger-fill;
        HorizontalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-s;
            Icon {
                source: @image-url("@lucide/circle-alert.svg");
                tint: Theme.danger-text;
                width: Theme.icon-small;
            }
            Selectable {
                text: root.entry.body;
                key: "e\{root.index}:text";
                default-color: Theme.danger-text;
                default-font-family: root.entry.font;
                line-height-factor: Theme.line-factor(root.entry.font);
            }
        }
    }
}
