// A task followed beside the conversation, read only, the latest at the foot: a subagent's
// work (what it was asked, what it says and each tool it calls), or what a background command
// prints. The chip's list of what runs opens it.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { StepKind, TaskKind } from "types.slint";
import { Peek } from "state.slint";
import { Caption, Icon, IconButton, Small } from "widgets.slint";

// What is said where nothing is shown yet.
component Empty inherits VerticalLayout {
    in property <string> text;
    padding: Theme.space-m;
    Small {
        text: root.text;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

component Conversation inherits VerticalLayout {
    follow-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            steps.content-y = min(0px, steps.visible-height - steps.content-height);
        }
    }
    if Peek.steps.length == 0: Empty {
        text: "Nothing of its conversation is saved yet. It shows here as it goes.";
    }
    steps := ListView {
        vertical-stretch: 1;
        // As the transcript does: the move waits for the pass that measured the rows.
        changed content-height => { follow-timer.running = true; }
        for step in Peek.steps: VerticalLayout {
            padding-left: Theme.space-m;
            padding-right: Theme.space-m;
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;
            if step.kind == StepKind.asked: Rectangle {
                border-radius: Theme.radius-l;
                background: Theme.bubble;
                HorizontalLayout {
                    padding: Theme.space-s;
                    padding-left: Theme.space-m;
                    padding-right: Theme.space-m;
                    Text {
                        text: step.text;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
            }
            if step.kind == StepKind.said: Text {
                text: step.text;
                color: Theme.text;
                wrap: word-wrap;
            }
            if step.kind == StepKind.called: HorizontalLayout {
                spacing: Theme.space-s;
                Small {
                    text: step.title;
                    color: Theme.text-secondary;
                    font-weight: 600;
                }
                Small {
                    text: step.text;
                    color: Theme.text-secondary;
                    font-family: Theme.mono;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

// What the command printed, a line a row, as a terminal shows it but wrapped.
component Output inherits VerticalLayout {
    follow-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            lines.content-y = min(0px, lines.visible-height - lines.content-height);
        }
    }
    if Peek.note != "": VerticalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        padding-top: Theme.space-s;
        Caption {
            text: Peek.note;
            wrap: word-wrap;
        }
    }
    if Peek.output.length == 0 && Peek.note == "": Empty {
        text: Peek.running ? "Nothing printed yet. It shows here as it goes." : "It printed nothing.";
    }
    lines := ListView {
        vertical-stretch: 1;
        changed content-height => { follow-timer.running = true; }
        for line in Peek.output: HorizontalLayout {
            padding-left: Theme.space-m;
            padding-right: Theme.space-m;
            Small {
                text: line;
                color: Theme.text;
                font-family: Theme.mono;
                wrap: char-wrap;
            }
        }
    }
}

export component PeekPanel inherits Rectangle {
    property <bool> conversation: Peek.kind == TaskKind.agent;
    background: Theme.surface-raised;
    VerticalLayout {
        HorizontalLayout {
            height: 52px;
            padding-left: Theme.space-m;
            padding-right: Theme.space-xs;
            spacing: Theme.space-s;
            Icon {
                source: root.conversation ? @image-url("@lucide/bot.svg") : @image-url("@lucide/square-terminal.svg");
                tint: Theme.claude;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Peek.title;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Caption {
                    text: Peek.running ? Peek.detail + " · running" : Peek.detail + " · ended";
                    overflow: elide;
                }
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: root.conversation ? "Stop following this agent" : "Stop following this command";
                y: (parent.height - self.height) / 2;
                clicked => { Peek.close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        if root.conversation: Conversation {
            vertical-stretch: 1;
        }
        if !root.conversation: Output {
            vertical-stretch: 1;
        }
    }
}
