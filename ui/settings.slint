// edualc's settings, over the conversation as the usage details are; Esc or the cross closes
// them. Each takes effect at once and is kept in `settings.json`.

import { Theme } from "theme.slint";
import { FocusArea, HanLanguage, SandboxAccess, SendKey } from "types.slint";
import { Focus, Preferences, Session } from "state.slint";
import { AreaFence, Caption, Icon, IconButton, Pressable, Small, TextButton, Title } from "widgets.slint";

// One of a setting's choices: its name, what it means, and whether it is the one in use.
component Choice inherits Pressable {
    in property <string> title;
    in property <string> detail;
    in property <bool> chosen;
    selected: root.chosen;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-label: root.title;
    accessible-description: root.detail;
    HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-m;
        spacing: Theme.space-s;
        // Centred on the title's line.
        Icon {
            source: root.chosen ? @image-url("@lucide/circle-check.svg") : @image-url("@lucide/circle.svg");
            tint: root.chosen ? Theme.accent : Theme.text-tertiary;
            width: Theme.icon-small;
            y: Theme.space-s + (title.preferred-height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            title := Text {
                text: root.title;
                color: Theme.text;
                accessible-role: none;
            }
            Small {
                text: root.detail;
                wrap: word-wrap;
            }
        }
    }
}

// A setting that is on or off: its name, what it means, and whether it is on.
component Check inherits Pressable {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.title;
    accessible-description: root.detail;
    // One that does nothing now (the display without the sandbox, say) is dimmed as a whole.
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-m;
        spacing: Theme.space-s;
        // Centred on the title's first line.
        Icon {
            source: root.checked ? @image-url("@lucide/square-check.svg") : @image-url("@lucide/square.svg");
            tint: root.checked && root.enabled ? Theme.accent : Theme.text-secondary;
            width: Theme.icon-small;
            y: Theme.space-s + (one-line.preferred-height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                wrap: word-wrap;
                accessible-role: none;
            }
            Small {
                text: root.detail;
                wrap: word-wrap;
            }
        }
    }
    one-line := Text {
        visible: false;
        text: " ";
        accessible-role: none;
    }
}

// The folders the sandbox lets Claude into so, beyond its own: each can be taken off, and
// another picked.
component SandboxFolders inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <[string]> folders;
    in property <SandboxAccess> access;
    spacing: Theme.space-xs;
    padding-left: Theme.space-m;
    Text {
        text: root.title;
        color: Theme.text;
    }
    Small {
        text: root.folders.length == 0 ? root.detail + " None yet." : root.detail;
        wrap: word-wrap;
    }
    for folder in root.folders: HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: folder;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 1rem * Theme.code-size;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        IconButton {
            icon: @image-url("@lucide/x.svg");
            label: "Take " + folder + " off";
            clicked => { Preferences.forget-sandbox-folder(root.access, folder); }
        }
    }
    HorizontalLayout {
        alignment: start;
        TextButton {
            text: "Add a folder…";
            label: "Add to " + root.title.to-lowercase();
            clicked => { Preferences.add-sandbox-folder(root.access); }
        }
    }
}

export component SettingsPanel inherits Rectangle {
    callback close;
    background: Theme.surface;
    // The focus comes in as it opens, and Tab goes round within it: what is typed must not go
    // to the composer it covers.
    init => {
        first-fence.focus();
        Focus.step(true);
    }
    first-fence := AreaFence {
        area: FocusArea.conversation;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                last-fence.focus();
                Focus.step(false);
            }
        }
    }
    VerticalLayout {
        HorizontalLayout {
            height: Theme.header;
            padding-left: Theme.space-xl;
            padding-right: Theme.space-m;
            spacing: Theme.space-m;
            Icon {
                source: @image-url("@lucide/settings.svg");
                tint: Theme.claude;
                width: 22px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Title {
                    text: "Settings";
                }
                Caption {
                    text: "Kept in edualc's settings.json; each takes effect at once";
                }
            }
            IconButton {
                icon: @image-url("@lucide/x.svg");
                label: "Back to the conversation (Esc)";
                y: (parent.height - self.height) / 2;
                clicked => { root.close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: page.preferred-height;
            page := VerticalLayout {
                x: (parent.width - self.width) / 2;
                width: min(root.width - 2 * Theme.space-xl, 640px);
                padding-top: Theme.space-l;
                padding-bottom: Theme.space-xl;
                spacing: Theme.space-xs;
                alignment: start;
                Text {
                    text: "Sandbox";
                    font-weight: 600;
                    color: Theme.text;
                }
                Small {
                    text: "In the sandbox, Claude Code and everything it starts may change only the project, its git folder, caches and temporary files, and can't read your private files. A change here starts Claude Code again; the conversation goes on.";
                    wrap: word-wrap;
                }
                Check {
                    title: "Sandbox Claude Code";
                    detail: Session.sandbox-on ? "Landlock keeps it to what is listed here." : "It runs with all your rights.";
                    checked: Session.sandbox-on;
                    clicked => { Session.toggle-sandbox(); }
                }
                Check {
                    title: "Let it use the display";
                    detail: "Windows on your desktop and the GPU, for testing user interfaces.";
                    checked: Session.sandbox-desktop;
                    enabled: Session.sandbox-on;
                    clicked => { Session.toggle-sandbox-desktop(); }
                }
                Check {
                    title: "Let it use USB devices and serial ports in " + Session.project;
                    detail: "For this folder and those under it: debug probes and boards, but also any other USB device you can open, such as a phone.";
                    checked: Session.sandbox-hardware;
                    enabled: Session.sandbox-on;
                    clicked => { Session.toggle-sandbox-hardware(); }
                }
                Check {
                    title: "Let it message other sessions without asking";
                    detail: "Each message it sends to another Claude Code session goes without a question to you; each still shows in the conversation. Off, you are asked about each, except a reply to a session of edualc's that wrote to it first.";
                    checked: Preferences.messages-unasked;
                    enabled: Session.sandbox-on;
                    clicked => { Preferences.toggle-messages-unasked(); }
                }
                SandboxFolders {
                    title: "Folders it may also read";
                    detail: "A toolchain's home, say, with what is under it.";
                    folders: Preferences.sandbox-read;
                    access: SandboxAccess.read;
                }
                SandboxFolders {
                    title: "Folders it may also change";
                    detail: "With what is under them.";
                    folders: Preferences.sandbox-write;
                    access: SandboxAccess.write;
                }
                Rectangle {
                    height: Theme.space-m;
                }
                Text {
                    text: "Sending";
                    font-weight: 600;
                    color: Theme.text;
                }
                Choice {
                    title: "Enter sends";
                    detail: "Shift+Enter or Ctrl+Enter start a new line.";
                    chosen: Preferences.send-key == SendKey.enter;
                    clicked => { Preferences.choose-send-key(SendKey.enter); }
                }
                Choice {
                    title: "Ctrl+Enter sends";
                    detail: "Enter starts a new line, so a stray Enter never sends half a message.";
                    chosen: Preferences.send-key == SendKey.ctrl-enter;
                    clicked => { Preferences.choose-send-key(SendKey.ctrl-enter); }
                }
                // Kana and Hangul tell a text's language themselves; Han characters alone don't.
                Text {
                    text: "Text in Han characters alone";
                    font-weight: 600;
                    color: Theme.text;
                }
                Small {
                    text: "Chinese, Japanese and Korean draw many Han characters differently. A message with kana is set as Japanese and one with Hangul as Korean; one in Han characters alone as chosen here.";
                    wrap: word-wrap;
                }
                Choice {
                    title: "Japanese";
                    detail: "Noto Sans CJK JP";
                    chosen: Preferences.han-language == HanLanguage.japanese;
                    clicked => { Preferences.choose-han-language(HanLanguage.japanese); }
                }
                Choice {
                    title: "Simplified Chinese";
                    detail: "Noto Sans CJK SC";
                    chosen: Preferences.han-language == HanLanguage.simplified-chinese;
                    clicked => { Preferences.choose-han-language(HanLanguage.simplified-chinese); }
                }
                Choice {
                    title: "Traditional Chinese";
                    detail: "Noto Sans CJK TC";
                    chosen: Preferences.han-language == HanLanguage.traditional-chinese;
                    clicked => { Preferences.choose-han-language(HanLanguage.traditional-chinese); }
                }
                Choice {
                    title: "Korean";
                    detail: "Noto Sans CJK KR";
                    chosen: Preferences.han-language == HanLanguage.korean;
                    clicked => { Preferences.choose-han-language(HanLanguage.korean); }
                }
            }
        }
    }
    last-fence := AreaFence {
        area: FocusArea.conversation;
        crossed => {
            if !Focus.going-round {
                Focus.going-round = true;
                first-fence.focus();
                Focus.step(true);
            }
        }
    }
}
