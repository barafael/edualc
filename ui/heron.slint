// edualc's heron, over a new session's empty conversation. It stands there while the
// conversation is empty, flies off when it begins, and flies in when a new one opens. It faces
// left, so it leaves to the upper left and comes in from the upper right.

import { Theme } from "theme.slint";

enum Flight { standing, leaving, away, arriving }

export component Heron inherits Rectangle {
    // Whether it belongs here: the conversation is empty.
    in property <bool> wanted;
    // How far it flies from where it stands before it is out of sight.
    in property <length> reach-x;
    in property <length> reach-y;
    // Not bound to `wanted`: the binding would go to `away` before the change below took off.
    property <Flight> flight: Flight.standing;
    // The wing beat's frame: up, level, down, level.
    property <int> beat;
    property <duration> flight-time: 1100ms;

    init => {
        if !root.wanted {
            root.flight = Flight.away;
        }
    }
    changed wanted => {
        root.beat = 0;
        if root.wanted {
            // Out of sight first, unanimated, so that it flies in from there.
            root.flight = Flight.away;
            approach.running = true;
        } else {
            approach.running = false;
            landing.running = false;
            root.flight = Flight.leaving;
            departure.running = true;
        }
    }

    approach := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            self.running = false;
            root.flight = Flight.arriving;
            landing.running = true;
        }
    }
    landing := Timer {
        interval: root.flight-time;
        running: false;
        triggered => {
            self.running = false;
            root.flight = Flight.standing;
        }
    }
    departure := Timer {
        interval: root.flight-time;
        running: false;
        triggered => {
            self.running = false;
            if !root.wanted {
                root.flight = Flight.away;
            }
        }
    }
    Timer {
        interval: 110ms;
        running: root.flight == Flight.leaving || root.flight == Flight.arriving;
        triggered => {
            root.beat = Math.mod(root.beat + 1, 4);
        }
    }

    bird := Image {
        width: root.width;
        height: root.height;
        image-fit: contain;
        colorize: Theme.claude;
        accessible-role: none;
        visible: root.flight != Flight.away;
        source: root.flight == Flight.standing ? @image-url("../assets/heron.svg")
            : root.beat == 0 ? @image-url("../assets/heron-wings-up.svg")
            : root.beat == 2 ? @image-url("../assets/heron-wings-down.svg")
            : @image-url("../assets/heron-wings-level.svg");
    }

    states [
        // Up first, then away: it climbs at once and gathers speed sideways.
        leaving when root.flight == Flight.leaving: {
            bird.x: -root.reach-x;
            bird.y: -root.reach-y;
            bird.opacity: 0;
            in {
                animate bird.x { duration: root.flight-time; easing: ease-in; }
                animate bird.y { duration: root.flight-time; easing: ease-out; }
                animate bird.opacity { duration: root.flight-time; easing: ease-in; }
            }
        }
        away when root.flight == Flight.away: {
            bird.x: root.reach-x;
            bird.y: -root.reach-y;
            bird.opacity: 0;
        }
        // Gliding in: it slows as it comes, and comes down last.
        arriving when root.flight == Flight.arriving: {
            bird.x: 0;
            bird.y: 0;
            bird.opacity: 1;
            in {
                animate bird.x { duration: root.flight-time; easing: ease-out; }
                animate bird.y { duration: root.flight-time; easing: ease-in; }
                animate bird.opacity { duration: root.flight-time / 2; easing: ease-out; }
            }
        }
    ]
}

// What the sidebar's heron does now and then, in this order.
enum Act { looking-back, preening, flapping }

// The heron at the top of the sidebar. It stands still, and about once a minute, for a second
// or so, it looks over its shoulder, preens or flaps its wings, in turn. In between only a timer
// waits, so nothing is redrawn for it.
export component HeronMark inherits Image {
    // The act it does next, or is doing.
    property <Act> act: Act.looking-back;
    // The act's frame; -1 while it stands.
    property <int> frame: -1;
    property <int> frames: root.act == Act.looking-back ? 1 : root.act == Act.preening ? 6 : 7;

    height: self.width;
    image-fit: contain;
    colorize: Theme.claude;
    accessible-role: none;
    source: root.frame < 0 ? @image-url("../assets/heron.svg")
        : root.act == Act.looking-back ? @image-url("../assets/heron-looking-back.svg")
        // Nibbling at its back.
        : root.act == Act.preening ? (Math.mod(root.frame, 2) == 0 ? @image-url("../assets/heron-preening-1.svg") : @image-url("../assets/heron-preening-2.svg"))
        // Wing beats: half up, up, half up, folded.
        : Math.mod(root.frame, 2) == 0 ? @image-url("../assets/heron-flapping-half.svg")
        : Math.mod(root.frame, 4) == 1 ? @image-url("../assets/heron-flapping-up.svg")
        : @image-url("../assets/heron.svg");

    // The wait before each act differs, so that it doesn't tick like a clock.
    Timer {
        interval: root.act == Act.looking-back ? 61s : root.act == Act.preening ? 83s : 47s;
        running: root.frame < 0;
        triggered => {
            root.frame = 0;
        }
    }
    // A look held, nibbles, wing beats.
    Timer {
        interval: root.act == Act.looking-back ? 1500ms : root.act == Act.preening ? 240ms : 110ms;
        running: root.frame >= 0;
        triggered => {
            if root.frame + 1 < root.frames {
                root.frame += 1;
            } else {
                root.frame = -1;
                root.act = root.act == Act.looking-back ? Act.preening
                    : root.act == Act.preening ? Act.flapping
                    : Act.looking-back;
            }
        }
    }
}
