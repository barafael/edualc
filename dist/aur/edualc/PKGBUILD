# Maintainer: Felin Tusun <16455996+felintusun@users.noreply.github.com>

pkgname=edualc
pkgver=0.1.0
pkgrel=1
pkgdesc='Native desktop window for Claude Code, sandboxed with Landlock'
arch=(x86_64 aarch64)
url='https://github.com/felintusun/edualc'
license=(GPL-3.0-or-later)
# fontconfig is linked; Wayland, xkbcommon and EGL (libglvnd) are opened at start
depends=(glibc libgcc fontconfig wayland libxkbcommon libglvnd)
makedepends=(cargo)
optdepends=(
  'claude-code: the Claude Code CLI that edualc runs (or Anthropic installer: claude on the PATH)'
  'xdg-dbus-proxy: the window'"'"'s filtered D-Bus, for screen readers and the light or dark setting'
  'wl-clipboard: pasting images'
  'ttf-fira-sans: the interface font (otherwise the desktop'"'"'s sans)'
  'ttf-fira-code: the code font (otherwise the desktop'"'"'s monospace)'
  'noto-fonts-cjk: Japanese, Chinese and Korean text'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0b7e56163d0ec0b8b818e66fbdc01f2c4180557b648172014ede1cef7f627862')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/edualc -t "$pkgdir/usr/bin"
  install -Dm644 assets/edualc.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 assets/edualc.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 THIRD_PARTY_LICENSES.md -t "$pkgdir/usr/share/licenses/$pkgname"
}
