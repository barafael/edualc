# Package metadata shared by every format (see formats.ncl). Name, version, licence and homepage
# come from Cargo.toml.
let cargo = import "../Cargo.toml" in
let FileRole = [| 'Program, 'DesktopEntry, 'Icon, 'Metainfo, 'Manual, 'Documentation, 'Notices, 'License |] in
let Path =
  std.contract.from_validator (fun value =>
    if std.is_string value && std.string.is_match "^[A-Za-z0-9._/-]+$" value then
      'Ok
    else
      'Error {
        message = "not a path the packaging files can hold",
        notes = ["Paths go into shell lines and RPM specs unquoted: letters, digits and `._/-` only."],
      }
  )
in
# A package's name in each distribution that has it.
let Named = {
  debian | String | optional,
  fedora | String | optional,
  arch | String | optional,
}
in
{
  # For formats.ncl. Named differently from `FileRole`: inside a record, `Role = Role` would refer
  # to the field itself.
  Role | not_exported = FileRole,

  name | String = cargo.package.name,
  # Desktop entry, icon, Wayland app id and AppStream id (also in src/desktop.rs).
  app_id | String = "io.github.felintusun.edualc",
  version | String = cargo.package.version,
  homepage | String = cargo.package.repository,
  # SPDX, as Cargo.toml has it.
  license | String = cargo.package.license,
  maintainer = {
    name | String = "Felin Tusun",
    email | String = "16455996+felintusun@users.noreply.github.com",
  },
  copyright | String = "2026 Felin Tusun",
  summary | String = cargo.package.description,
  description
    | String
    = "A native desktop window for Claude Code, Anthropic's coding agent: conversations, permission prompts, plans to comment on, and sessions across projects, without the terminal UI. It runs Claude Code's command-line program, sandboxed with Landlock by default, so Claude Code must be installed.",

  # Files shipped, by source path in the tree. Each format places them by role.
  files
    | Array { source | Path, role | FileRole }
    = [
      { source = "target/release/edualc", role = 'Program },
      { source = "assets/io.github.felintusun.edualc.desktop", role = 'DesktopEntry },
      { source = "assets/io.github.felintusun.edualc.svg", role = 'Icon },
      # Generated from formats.ncl (`metainfo`).
      { source = "assets/io.github.felintusun.edualc.metainfo.xml", role = 'Metainfo },
      # Generated by a test in src/start/manual.rs.
      { source = "assets/edualc.1", role = 'Manual },
      { source = "README.md", role = 'Documentation },
      { source = "THIRD_PARTY_LICENSES.md", role = 'Notices },
      { source = "LICENSE", role = 'License },
    ],

  # Libraries winit loads at runtime (dlopen). Linked libraries are found in the binary by
  # dpkg-shlibdeps and rpmbuild.
  opened
    | Array (Named & { soname | String })
    = [
      { soname = "libwayland-client.so.0", debian = "libwayland-client0", arch = "wayland" },
      { soname = "libwayland-egl.so.1", debian = "libwayland-egl1", arch = "wayland" },
      { soname = "libxkbcommon.so.0", debian = "libxkbcommon0", arch = "libxkbcommon" },
      { soname = "libEGL.so.1", debian = "libegl1", arch = "libglvnd" },
    ],
  # Arch packages needed besides those: the linked libraries, which makepkg doesn't detect, and
  # the icon theme the icon goes into.
  needed_on_arch | Array String = ["glibc", "libgcc", "fontconfig", "hicolor-icon-theme"],

  # Optional packages edualc uses, and what for.
  recommended
    | Array (Named & { why | String })
    = [
      {
        why = "the window's filtered D-Bus, for screen readers and the light or dark setting",
        debian = "xdg-dbus-proxy",
        fedora = "xdg-dbus-proxy",
        arch = "xdg-dbus-proxy",
      },
      {
        why = "pasting images",
        debian = "wl-clipboard",
        fedora = "wl-clipboard",
        arch = "wl-clipboard",
      },
      {
        why = "the Claude Code CLI that edualc runs (or Anthropic's installer: claude on the PATH)",
        arch = "claude-code",
      },
      { why = "the interface font (otherwise the desktop's sans)", arch = "ttf-fira-sans" },
      { why = "the code font (otherwise the desktop's monospace)", arch = "ttf-fira-code" },
      { why = "Japanese, Chinese and Korean text", arch = "noto-fonts-cjk" },
    ],
}
